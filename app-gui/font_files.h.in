/**
 * @file    font_files.h
 * @brief   Bytes of the bundled fonts, generated by CMake from assets/fonts; do not edit.
 */

#ifndef IMCSIM_FONT_FILES_H
#define IMCSIM_FONT_FILES_H

#include <array>

namespace GUI {

// Inter, the interface font, and JetBrains Mono, for code-like text; both under the SIL Open Font License
inline constexpr std::array<unsigned char, @INTER_FONT_SIZE@> InterFont = {@INTER_FONT_BYTES@};
inline constexpr std::array<unsigned char, @MONOSPACE_FONT_SIZE@> MonospaceFont = {@MONOSPACE_FONT_BYTES@};

} // namespace GUI

#endif // IMCSIM_FONT_FILES_H
