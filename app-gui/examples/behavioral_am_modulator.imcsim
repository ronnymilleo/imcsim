     "pulse": {"delay": 0, "fall": 1e-06, "high": 5, "low": 0, "period": 0.001, "rise": 1e-06, "width": 0.0005},
     "name": "Vin1"},
    {"type": "VoltageSource", "rotation": 90, "x": 12, "y": 8, "source": "AC", "value": 0, "amplitude": 1,
