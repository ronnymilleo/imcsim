    {"type": "Resistor", "rotation": 90, "x": 38, "y": 7, "value": 10000, "name": "R1"},
    {"type": "NetLabel", "rotation": 0, "x": 4, "y": 4, "net": "CARRIER"},
    {"type": "NetLabel", "rotation": 0, "x": 12, "y": 4, "net": "MSG"},
