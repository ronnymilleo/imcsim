#include <winver.h>

// The first icon of the executable: Explorer shows it, and SDL gives it to every window it creates
1 ICON "imcsim.ico"

// The details Explorer lists in the file properties; CMake passes the version from project() in the root
// CMakeLists.txt, so every build carries the same product name and version
VS_VERSION_INFO VERSIONINFO
FILEVERSION IMCSIM_VERSION_MAJOR, IMCSIM_VERSION_MINOR, IMCSIM_VERSION_PATCH, 0
PRODUCTVERSION IMCSIM_VERSION_MAJOR, IMCSIM_VERSION_MINOR, IMCSIM_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // U.S. English, Unicode
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Ronny Milleo"
            VALUE "FileDescription", "imcsim - Immediate Mode Circuit Simulator"
            VALUE "FileVersion", IMCSIM_VERSION
            VALUE "InternalName", "imcsim"
            VALUE "LegalCopyright", "Copyright (C) Ronny Milleo, GPL-3.0-or-later"
            VALUE "OriginalFilename", "imcsim.exe"
            VALUE "ProductName", "imcsim"
            VALUE "ProductVersion", IMCSIM_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
